{
  "name": "cinematic-video-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic cinematic short-form video generator built on React + Remotion.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "ts-node --esm src/render.ts",
    "render:landscape": "ts-node --esm src/render.ts configs/sample.json landscape",
    "render:portrait": "ts-node --esm src/render.ts configs/sample.json portrait",
    "ui": "node ui/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.240",
    "@remotion/cli": "^4.0.240",
    "@remotion/google-fonts": "^4.0.240",
    "@remotion/renderer": "^4.0.240",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.240"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
