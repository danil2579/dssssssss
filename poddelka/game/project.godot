; Engine configuration file.
; Проект «ПОДДЕЛКА». Открывать в Godot 4.7.x (стандартная сборка, не .NET).

config_version=5

[application]

config/name="Poddelka"
config/description="Кооп-ограбление музея: рисуй подделки, пока друзья отвлекают охрану."
config/version="0.1.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
